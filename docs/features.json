  {
   "id": "proxy-status-disabled",
   "name": "Proxy status \u2014 disabled state display",
   "category": "cli",
   "status": "verified",
   "since": "0.5.1",
   "screenshot": "assets/Screenshot_proxy_status.png",
   "note": "on a real terminal: red status line with the enable hint, the deciding proxy_active line white-highlighted, the whole config.json in grey below (the screenshot predates the presets refactor \u2014 proxy_enabled flat keys are now gone, the config holds only proxy_presets + proxy_active)",
   "anchor": {
    "file": "src/proxy_commands.cpp",
    "pattern": "proxy: disabled"
   }
  },
  {
   "id": "proxy-status-enabled",
   "name": "Proxy status \u2014 enabled state display",
   "category": "cli",
   "status": "implemented",
   "since": "0.5.1",
   "note": "white line with socks5h://host:port and the auth flag when set \u2014 same layout as the disabled state; not captured on a screenshot yet",
   "anchor": {
    "file": "src/proxy_commands.cpp",
    "pattern": "\"proxy: \" \\+ proxyTypeName"
   }
  },
  {
   "id": "proxy-status-json",
   "name": "Proxy status \u2014 machine-readable --json",
   "category": "cli",
   "status": "implemented",
   "since": "0.5.1",
   "note": "prints {\"enabled\", \"host\", \"port\", \"type\", \"auth\"}; whether the values match config.json still needs the manual test",
   "anchor": {
    "file": "src/proxy_commands.cpp",
    "pattern": "j\\[\"enabled\"\\]"
   }
  },
  {
   "id": "proxy-status-truthful",
   "name": "Proxy status \u2014 reported state is truthful",
   "category": "cli",
   "status": "implemented",
   "since": "0.5.1",
   "note": "'proxy on' flips the line to the enabled state (socks5h://host:port + auth flag when set), 'proxy off' back to disabled, --json prints the same state machine-readable. NOT manually verified yet \u2014 whether the reported state always matches config.json still needs a manual test (the user will do it later).",
   "anchor": {
    "file": "src/proxy_commands.cpp",
    "pattern": "j\\[\"enabled\"\\]"
   }
  },
