# Maintainer: Progressive Chat Team <dev@progressive.chat>

pkgname=progressive-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="A terminal Matrix client with E2EE, multi-format REST API, and ncurses TUI"
arch=('x86_64')
url="https://github.com/progressive-chat/progressive-cli"
license=('AGPL-3.0-or-later')
depends=(
    'gcc-libs'
    'openssl'
    'libolm'
    'sqlite3'
    'ncurses'
    'nlohmann-json'
)
makedepends=(
    'cmake'
    'gcc'
    'make'
    'pkg-config'
    'git'
)
optdepends=(
    'libnotify: desktop notifications via notify-send'
)
source=("${pkgname}::git+https://github.com/progressive-chat/progressive-cli.git#branch=main")
md5sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.1.0"
}

build() {
    cd "${srcdir}/${pkgname}/cppcli"

    cmake -B build -S . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DUSE_SYSTEM_OLM=ON \
        -DBUILD_TESTS=OFF \
        -DBUILD_TUI=ON

    cmake --build build -j$(nproc)
}

package() {
    cd "${srcdir}/${pkgname}"

    install -Dm755 cppcli/build/src/progressive-cli "${pkgdir}/usr/bin/progressive-cli"
    # The compat symlink for the pre-rebrand scripts.
    ln -s progressive-cli "${pkgdir}/usr/bin/matrixcli"

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    # Optional systemd user unit for the notification forwarding daemon
    # (installed, not enabled: systemctl --user enable progressive-cli-notify)
    install -Dm644 packaging/arch/progressive-cli-notify.service \
        "${pkgdir}/usr/lib/systemd/user/progressive-cli-notify.service"

    # Desktop entry
    install -dm755 "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/${pkgname}.desktop" << 'EOF'
[Desktop Entry]
Name=progressive-cli
Comment=Terminal Matrix client with E2EE
Exec=progressive-cli tui
Terminal=true
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=matrix;chat;terminal;cli;e2ee;
EOF

    # Bash completion (kept in sync with the 'completion' command word list;
    # for the full generated list run: progressive-cli completion bash)
    install -dm755 "${pkgdir}/usr/share/bash-completion/completions"
    cat > "${pkgdir}/usr/share/bash-completion/completions/progressive-cli" << 'EOF'
_matrixcli() {
    local cur prev
    _init_completion || return
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    if [[ $COMP_CWORD -eq 1 ]]; then
        COMPREPLY=($(compgen -W "serve ttys login register status rooms spaces view send attach demo ui tui link join knock permalink info invite copy dump power members threads vote react notify proxy call llm agent agent-code e2ee backup crosssign ssss verify config completion help version" -- "$cur"))
    fi
    case $prev in
        serve|demo)
            COMPREPLY=($(compgen -W "--port --host --demo --ttys --token --bind --sync --cache --help" -- "$cur"))
            ;;
        login|register)
            COMPREPLY=($(compgen -W "--homeserver --username --mxid --password --token --reg-token --email --mas --interactive --json --help" -- "$cur"))
            ;;
    esac
}
complete -F _matrixcli progressive-cli
complete -F _matrixcli matrixcli
EOF
    # Compat symlink for the pre-rebrand completion name.
    ln -s progressive-cli "${pkgdir}/usr/share/bash-completion/completions/matrixcli"
}
